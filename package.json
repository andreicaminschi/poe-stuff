{
  "name": "poe-stuff",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc",
    "typecheck:watch": "tsc --watch",
    "etl:all": "node --env-file=packages/etl/.env packages/etl/tools/all.ts",
    "etl:stats": "node --env-file=packages/etl/.env packages/etl/tools/stats.ts",
    "etl:items": "node --env-file=packages/etl/.env packages/etl/tools/items.ts",
    "etl:static": "node --env-file=packages/etl/.env packages/etl/tools/static.ts",
    "etl:filters": "node --env-file=packages/etl/.env packages/etl/tools/filters.ts",
    "etl:leagues": "node --env-file=packages/etl/.env packages/etl/tools/leagues.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-plugin-import": "2.25.3",
    "eslint-plugin-jsx-a11y": "6.5.1",
    "eslint-plugin-react": "7.28.0",
    "eslint-plugin-react-hooks": "4.3.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
