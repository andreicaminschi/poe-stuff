{
  "name": "poe-stuff",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "lib/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "catalog": "node --env-file=apps/catalog/.env apps/catalog/catalog-cli.ts",
    "taxonomy": "node apps/taxonomy/taxonomy-cli.ts",
    "taxonomy:publish": "node apps/taxonomy/taxonomy-cli.ts publish",
    "taxonomy:republish": "node apps/taxonomy/taxonomy-cli.ts republish",
    "taxonomy:promote": "node apps/taxonomy/taxonomy-cli.ts promote",
    "typecheck": "tsc",
    "typecheck:watch": "tsc --watch",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "duplicates": "node apps/catalog/find-duplicates-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-plugin-import": "2.25.3",
    "eslint-plugin-jsx-a11y": "6.5.1",
    "eslint-plugin-react": "7.28.0",
    "eslint-plugin-react-hooks": "4.3.0",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
