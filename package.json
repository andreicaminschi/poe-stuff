{
  "name": "poe-stuff",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "lib/*",
    "services/*"
  ],
  "scripts": {
    "admin-panel": "yarn workspace @poe/admin-panel dev",
    "admin-panel:migrate": "node apps/admin-panel/migrate-cli.ts",
    "admin-panel:unique-names": "node apps/admin-panel/unique-names-cli.ts",
    "admin-panel:generate-training": "node apps/admin-panel/generate-training-cli.ts",
    "admin-panel:benchmark-agent": "node apps/admin-panel/benchmark-agent-cli.ts",
    "admin-panel:eval-adapters": "node apps/admin-panel/eval-adapters-cli.ts",
    "admin-panel:feedback-to-rows": "node apps/admin-panel/feedback-to-rows-cli.ts",
    "admin-panel:predict-models": "yarn workspace @poe/admin-panel predict-models",
    "agent:generate-training-data": "bash -c 'node apps/admin-panel/generate-training-cli.ts --version=data-check --count=100 \"$@\" && node apps/admin-panel/generate-training-cli.ts --version=data-check --count=100 \"$@\" --unseen-only' --",
    "agent:goals": "node apps/agent-training/build-goals-cli.ts",
    "agent:rows": "node apps/agent-training/build-rows-cli.ts",
    "agent:score": "node apps/agent-training/score-run-cli.ts",
    "agent:train": "bash apps/training/train.sh",
    "agent:eval": "bash apps/training/eval.sh",
    "catalog": "node --env-file=apps/catalog/.env apps/catalog/catalog-cli.ts",
    "catalog:publish": "node apps/catalog/publish-catalog-cli.ts",
    "catalog:compile": "node apps/catalog/compile-cli.ts",
    "catalog:validate": "node apps/catalog/validate-cli.ts",
    "taxonomy": "node apps/taxonomy/taxonomy-cli.ts",
    "taxonomy:publish": "node apps/taxonomy/taxonomy-cli.ts publish",
    "taxonomy:init": "node apps/taxonomy/taxonomy-cli.ts init",
    "taxonomy:create": "node apps/taxonomy/taxonomy-cli.ts create",
    "taxonomy:promote": "node apps/taxonomy/taxonomy-cli.ts promote",
    "taxonomy:seed": "node apps/taxonomy/seed-taxonomy-cli.ts",
    "taxonomy:build-eval-cases": "node apps/taxonomy/build-eval-cases-cli.ts",
    "typecheck": "tsc && yarn workspace @poe/admin-panel typecheck",
    "typecheck:watch": "tsc --watch",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "duplicates": "node apps/catalog/find-duplicates-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
