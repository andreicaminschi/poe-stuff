node_modules/
.env
*.tsbuildinfo
.yarn/*

# Scratch data: downloaded dumps and working files.
data/*
data/raw/
# Except the parser fixtures. lib/item-parser reads this folder in two tests and asserts
# it finds more than thirty items, so a clone without it has a failing suite.
!data/sample-items/
# The local stand-in for object storage. Kept out of git on purpose, but NOT all of it is
# re-fetchable: .s3/taxonomy is the only copy of the hand-written taxonomy. Back it up.
.s3/

# Superseded by .s3 — still listed so an old checkout does not start committing them.
cache/
logs/

# The admin panel's build output and packaged app.
apps/admin-panel/out/
apps/admin-panel/release/

# Feature plans. Written before the work, kept locally, never pushed.
docs/plans/

# Generated by the deprecated @poe/filterv2.
packages/filterv2/data/items.json
