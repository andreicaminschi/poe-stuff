{
  "name": "@poe/admin-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win --dir",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@poe/lake": "workspace:^",
    "@poe/taxonomy": "workspace:^",
    "@types/node": "^26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^6.0.0",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "poe-stuff.admin-panel",
    "productName": "Taxonomy admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
