FROM docker.io/pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

RUN pip install --no-cache-dir "transformers>=4.48,<5" "peft>=0.13" "accelerate>=1.0" "onnx>=1.16" "onnxruntime>=1.19" sentencepiece

# Unsloth compiles GPU kernels on first use, so it needs a C compiler. torch stays pinned.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir unsloth "torch==2.7.1" \
    && pip uninstall -y torchao

# Pinned: the same llama.cpp node-llama-cpp bundles.
ADD https://github.com/ggml-org/llama.cpp/archive/refs/tags/v0.5.0.tar.gz /tmp/llama.cpp.tar.gz
RUN mkdir -p /opt/llama.cpp && tar -xzf /tmp/llama.cpp.tar.gz -C /opt/llama.cpp --strip-components=1 && rm /tmp/llama.cpp.tar.gz \
    && pip install --no-cache-dir /opt/llama.cpp/gguf-py

# llama-quantize writes the Q4 filler. CPU build only.
RUN apt-get update && apt-get install -y --no-install-recommends cmake && rm -rf /var/lib/apt/lists/* \
    && cmake -S /opt/llama.cpp -B /opt/llama.cpp/build -DGGML_CUDA=OFF -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF \
    && cmake --build /opt/llama.cpp/build --target llama-quantize -j

ENV HF_HOME=/cache/huggingface PYTHONUNBUFFERED=1 TRITON_LIBCUDA_PATH=/opt/libcuda PYTHONPYCACHEPREFIX=/data/.pycache
WORKDIR /app
COPY *.py /app/
COPY entry.sh /app/entry.sh
RUN chmod +x /app/entry.sh
ENTRYPOINT ["/app/entry.sh"]
